programa{
	funcao inicio(){

		inteiro numero
		
		escreva("Digite um número: ")
		leia(numero)

		se (numero < 0){
			escreva("\nSeu número é negativo")
		} senao{

			se (numero > 0) {
				escreva("\nSeu número é positivo")
			} senao {
				escreva("É zero")
			}
		}
	}
}
