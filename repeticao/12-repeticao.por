programa{
	funcao inicio(){
		
		cadeia marca
		cadeia cor
		logico tem_quatro_portas

		escreva("Digite a marca do seu carro: ")
		leia(marca)

		escreva("\nDigite a cor do seu carro: ")
		leia(cor)

		escreva("\nSeu carro tem quatro portas: ")
		leia(tem_quatro_portas)
		
	}
}
