programa{
	funcao inicio(){
		
		cadeia palavra
		
		escreva("Escreva uma palvara: ")
		leia(palavra)
		
		se (palavra == "Algoritmo"){
			escreva("ALG")
		} senao{
			escreva("Error")
		}
		
	}
}
