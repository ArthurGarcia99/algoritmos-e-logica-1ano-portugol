programa{
	funcao inicio(){

		inteiro valor1
		inteiro valor2
		

		escreva("Leia o valor 1: ")
		leia(valor1)
		escreva("Leia o valor 2: ")
		leia(valor2)

		
		inteiro media = ((valor1 + valor2) / 2)
		escreva(media)

		
	}
}
