programa {
  funcao inicio() {
    inteiro n = 0
    inteiro c = 0

    faca{

      escreva("\nQual Numero? ")
      leia(n)
      c++
      
      se(n > 1){
        escreva("Alto")
      }senao se(n < 1){
        escreva("Baixo")
      }
    }enquanto(n != 1)


      escreva("Você Acertou.")
      escreva("\n" , c)
  }
}

