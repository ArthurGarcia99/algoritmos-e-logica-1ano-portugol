programa{
	funcao inicio(){
		
		cadeia nome
		inteiro carro
		real vendas

		
		escreva("Escreva o nome do vendedor: ")
		leia(nome)
		
		escreva("Escreva o numero de carros vendidos: ")
		leia(carro)

		escreva("Escreva o valor total de vendas: ")
		leia(vendas)

		escreva("O salario do venderdor", nome ,"foi de: ", 500 + (50  * carro) + (vendas * 0.05) )

		
	}
}
