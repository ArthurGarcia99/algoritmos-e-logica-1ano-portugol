programa{
	funcao inicio(){

		inteiro n1
		
		
		escreva("Escolha um número: ")
		leia(n1)

		//Resto da divisão do número por 2
		inteiro resto = n1 % 2

		//se (resto == 0){
		se ( (n1 % 2) == 0){
			escreva("\nO número é par!")
		}
		senao{
			escreva("\nO número é impar!")
		}
	}
}
