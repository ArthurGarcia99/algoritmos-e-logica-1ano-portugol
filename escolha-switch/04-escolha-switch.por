programa {
  funcao inicio() {
    inteiro valor1

    escreva("Informe um numero entre 1 e 10: ")
    leia(valor1)

    escolha(valor1){
      caso 1:
      escreva("um")
      pare

      caso 2:
      escreva("dois")
      pare

      caso 3:
      escreva("tres")
      pare

      caso contrario:
      escreva("vc digitou errado")
    }
  }
}
